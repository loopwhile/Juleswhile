{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://juleswhile.local/schemas/project-state.schema.json",
  "title": "Juleswhile Project State",
  "description": "Committed snapshot of Juleswhile project orchestration state.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "projectId",
    "stateAuthority",
    "status",
    "phase",
    "primaryBranch",
    "repository",
    "projectGoal",
    "automation",
    "taskSummary",
    "runtime",
    "quotas",
    "lastEvent",
    "createdAt",
    "updatedAt"
  ],
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "const": 1
    },
    "projectId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{1,62}[a-z0-9]$",
      "minLength": 3,
      "maxLength": 64
    },
    "stateAuthority": {
      "type": "string",
      "const": "github-issues-and-pull-requests"
    },
    "status": {
      "type": "string",
      "enum": [
        "bootstrap",
        "active",
        "paused",
        "blocked",
        "completed",
        "cancelled"
      ]
    },
    "phase": {
      "type": "string",
      "enum": [
        "bootstrap",
        "goal-intake",
        "planning",
        "research",
        "product-definition",
        "architecture",
        "design",
        "implementation",
        "verification",
        "deployment",
        "operations",
        "completed"
      ]
    },
    "primaryBranch": {
      "type": "string",
      "const": "main"
    },
    "repository": {
      "$ref": "#/$defs/repository"
    },
    "projectGoal": {
      "oneOf": [
        {
          "$ref": "https://juleswhile.local/schemas/project-goal.schema.json"
        },
        {
          "type": "null"
        }
      ]
    },
    "automation": {
      "$ref": "#/$defs/automation"
    },
    "taskSummary": {
      "$ref": "#/$defs/taskSummary"
    },
    "runtime": {
      "$ref": "#/$defs/runtime"
    },
    "quotas": {
      "$ref": "#/$defs/quotas"
    },
    "lastEvent": {
      "oneOf": [
        {
          "$ref": "#/$defs/event"
        },
        {
          "type": "null"
        }
      ]
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time"
    }
  },
  "$defs": {
    "taskId": {
      "type": "string",
      "pattern": "^TASK-[0-9]{3,}$"
    },
    "nullableDateTime": {
      "oneOf": [
        {
          "type": "string",
          "format": "date-time"
        },
        {
          "type": "null"
        }
      ]
    },
    "repository": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fullName",
        "htmlUrl",
        "julesSourceName"
      ],
      "properties": {
        "fullName": {
          "oneOf": [
            {
              "type": "string",
              "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
            },
            {
              "type": "null"
            }
          ]
        },
        "htmlUrl": {
          "oneOf": [
            {
              "type": "string",
              "format": "uri",
              "pattern": "^https://github\\.com/"
            },
            {
              "type": "null"
            }
          ]
        },
        "julesSourceName": {
          "oneOf": [
            {
              "type": "string",
              "pattern": "^sources/github/[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "automation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled",
        "contentEnabled",
        "netlifyStatusEnabled",
        "mode",
        "pausedReason"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "contentEnabled": {
          "type": "boolean"
        },
        "netlifyStatusEnabled": {
          "type": "boolean"
        },
        "mode": {
          "type": "string",
          "enum": [
            "manual",
            "guarded",
            "limited-autonomous"
          ]
        },
        "pausedReason": {
          "oneOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 2000
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "taskSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "total",
        "draft",
        "ready",
        "queued",
        "dispatching",
        "running",
        "prOpened",
        "validating",
        "correcting",
        "mergeReady",
        "merged",
        "deploying",
        "completed",
        "failed",
        "timeout",
        "retryWait",
        "blocked",
        "cancelled",
        "templates"
      ],
      "properties": {
        "total": {
          "type": "integer",
          "minimum": 0
        },
        "draft": {
          "type": "integer",
          "minimum": 0
        },
        "ready": {
          "type": "integer",
          "minimum": 0
        },
        "queued": {
          "type": "integer",
          "minimum": 0
        },
        "dispatching": {
          "type": "integer",
          "minimum": 0
        },
        "running": {
          "type": "integer",
          "minimum": 0
        },
        "prOpened": {
          "type": "integer",
          "minimum": 0
        },
        "validating": {
          "type": "integer",
          "minimum": 0
        },
        "correcting": {
          "type": "integer",
          "minimum": 0
        },
        "mergeReady": {
          "type": "integer",
          "minimum": 0
        },
        "merged": {
          "type": "integer",
          "minimum": 0
        },
        "deploying": {
          "type": "integer",
          "minimum": 0
        },
        "completed": {
          "type": "integer",
          "minimum": 0
        },
        "failed": {
          "type": "integer",
          "minimum": 0
        },
        "timeout": {
          "type": "integer",
          "minimum": 0
        },
        "retryWait": {
          "type": "integer",
          "minimum": 0
        },
        "blocked": {
          "type": "integer",
          "minimum": 0
        },
        "cancelled": {
          "type": "integer",
          "minimum": 0
        },
        "templates": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "activeSessions",
        "activePullRequests",
        "resourceLocks",
        "lastReconciledAt"
      ],
      "properties": {
        "activeSessions": {
          "type": "array",
          "maxItems": 15,
          "items": {
            "$ref": "#/$defs/session"
          }
        },
        "activePullRequests": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "$ref": "#/$defs/pullRequest"
          }
        },
        "resourceLocks": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "$ref": "#/$defs/resourceLock"
          }
        },
        "lastReconciledAt": {
          "$ref": "#/$defs/nullableDateTime"
        }
      }
    },
    "session": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "taskId",
        "issueNumber",
        "sessionName",
        "sessionId",
        "sessionUrl",
        "state",
        "attempt",
        "startedAt",
        "lastObservedAt"
      ],
      "properties": {
        "taskId": {
          "$ref": "#/$defs/taskId"
        },
        "issueNumber": {
          "type": "integer",
          "minimum": 1
        },
        "sessionName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "sessionId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "sessionUrl": {
          "oneOf": [
            {
              "type": "string",
              "format": "uri"
            },
            {
              "type": "null"
            }
          ]
        },
        "state": {
          "type": "string",
          "enum": [
            "QUEUED",
            "PLANNING",
            "AWAITING_PLAN_APPROVAL",
            "IN_PROGRESS",
            "COMPLETED",
            "FAILED",
            "CANCELLED",
            "UNKNOWN"
          ]
        },
        "attempt": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10
        },
        "startedAt": {
          "type": "string",
          "format": "date-time"
        },
        "lastObservedAt": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "pullRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "taskId",
        "issueNumber",
        "number",
        "url",
        "headSha",
        "state",
        "openedAt"
      ],
      "properties": {
        "taskId": {
          "$ref": "#/$defs/taskId"
        },
        "issueNumber": {
          "type": "integer",
          "minimum": 1
        },
        "number": {
          "type": "integer",
          "minimum": 1
        },
        "url": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://github\\.com/"
        },
        "headSha": {
          "type": "string",
          "pattern": "^[0-9a-f]{7,40}$"
        },
        "state": {
          "type": "string",
          "enum": [
            "open",
            "draft",
            "closed",
            "merged"
          ]
        },
        "openedAt": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "resourceLock": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "resource",
        "taskId",
        "acquiredAt",
        "expiresAt"
      ],
      "properties": {
        "resource": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "taskId": {
          "$ref": "#/$defs/taskId"
        },
        "acquiredAt": {
          "type": "string",
          "format": "date-time"
        },
        "expiresAt": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "quotas": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "date",
        "hardLimit",
        "newTaskBudget",
        "correctionBudget",
        "maintenanceBudget",
        "reserve",
        "maxConcurrent",
        "used"
      ],
      "properties": {
        "date": {
          "oneOf": [
            {
              "type": "string",
              "format": "date"
            },
            {
              "type": "null"
            }
          ]
        },
        "hardLimit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000
        },
        "newTaskBudget": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000
        },
        "correctionBudget": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000
        },
        "maintenanceBudget": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000
        },
        "reserve": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000
        },
        "maxConcurrent": {
          "type": "integer",
          "minimum": 1,
          "maximum": 15
        },
        "used": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "newTasks",
            "corrections",
            "maintenance",
            "total"
          ],
          "properties": {
            "newTasks": {
              "type": "integer",
              "minimum": 0
            },
            "corrections": {
              "type": "integer",
              "minimum": 0
            },
            "maintenance": {
              "type": "integer",
              "minimum": 0
            },
            "total": {
              "type": "integer",
              "minimum": 0
            }
          }
        }
      }
    },
    "event": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "source",
        "taskId",
        "issueNumber",
        "occurredAt",
        "runUrl"
      ],
      "properties": {
        "type": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "source": {
          "type": "string",
          "enum": [
            "user",
            "github-actions",
            "jules",
            "netlify",
            "reconciler"
          ]
        },
        "taskId": {
          "oneOf": [
            {
              "$ref": "#/$defs/taskId"
            },
            {
              "type": "null"
            }
          ]
        },
        "issueNumber": {
          "oneOf": [
            {
              "type": "integer",
              "minimum": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "occurredAt": {
          "type": "string",
          "format": "date-time"
        },
        "runUrl": {
          "oneOf": [
            {
              "type": "string",
              "format": "uri"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    }
  }
}