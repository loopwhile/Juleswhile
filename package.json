{
  "name": "juleswhile",
  "version": "0.1.0",
  "private": true,
  "description": "GitHub, Google Jules, Stitch MCP, and Netlify based event-driven AI project factory template.",
  "type": "module",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22.0.0",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "validate:schemas": "tsx ops/scripts/validate-schemas.ts",
    "validate:task-graph": "tsx ops/scripts/validate-task-graph.ts --mode graph",
    "validate:supply-chain": "tsx ops/scripts/validate-workflow-supply-chain.ts",
    "validate:source-size": "tsx ops/scripts/validate-source-size.ts",
    "validate:pr-scope": "tsx ops/scripts/validate-task-graph.ts --mode pr-scope",
    "dispatch:jules": "tsx ops/scripts/dispatch-jules.ts",
    "select:next-task": "tsx ops/scripts/select-next-task.ts",
    "materialize:issues": "tsx ops/scripts/materialize-issues.ts",
    "reconcile:project": "tsx ops/scripts/reconcile-project.ts",
    "project:state": "tsx ops/scripts/rebuild-project-state.ts",
    "sbom:cyclonedx": "npm sbom --package-lock-only --sbom-format cyclonedx",
    "hash:artifacts": "tsx ops/scripts/hash-release-artifacts.ts",
    "lint": "biome lint ops/scripts",
    "typecheck": "tsc --noEmit --target ES2022 --module NodeNext --moduleResolution NodeNext --lib ES2022,DOM --strict --skipLibCheck --types node ops/scripts/*.ts",
    "test:template": "npm run validate:schemas && npm run validate:task-graph && npm run validate:source-size && npm run typecheck",
    "test:unit": "node --import tsx --test ops/scripts/*.test.ts",
    "test": "npm run test:template && npm run test:unit",
    "build": "npm run clean && tsx ops/scripts/build-dashboard.ts",
    "check": "npm run lint && npm run validate:supply-chain && npm run test && npm run build",
    "ci": "npm run check",
    "transition:task-state": "tsx ops/scripts/task-state-transition.ts"
  },
  "dependencies": {
    "minimatch": "^10.0.0",
    "tsx": "^4.0.0",
    "yaml": "^2.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.0",
    "@types/node": "^22.0.0",
    "ajv": "^8.0.0",
    "ajv-formats": "^3.0.0",
    "typescript": "^5.0.0"
  }
}
